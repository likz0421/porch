# 统一换行：脚本一律 LF（要在 Linux / OpenWrt 上被 sh 解释），
# 只有 Windows 的批处理与 PowerShell 用 CRLF。
* text=auto eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 二进制：不要做任何换行/编码转换
*.png  binary
*.jpg  binary
*.ico  binary
*.zip  binary
*.gz   binary
*.ipk  binary
*.exe  binary

# 脚本保持可执行位（Windows 上 core.filemode=false 时靠这里兜住）
*.sh   text eol=lf
